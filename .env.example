# Regto 环境配置模板 —— 复制为 .env 后填入真实值
# cp .env.example .env

# 应用连接：最小权限账号，仅 CRUD，无 CREATE（DDL 一律走迁移）
REGTO_DATABASE_URL=postgres://regto_app:<app-password>@127.0.0.1:5432/regto?sslmode=disable

# 迁移连接：超级用户，仅供 cmd/migrate 使用（应用代码禁止引用）
REGTO_MIGRATION_URL=postgres://postgres:<superuser-password>@127.0.0.1:5432/regto?sslmode=disable

# 认证：access token 的 HMAC 密钥（至少 32 字节）。
# 缺失或过短时 regto-server **拒绝启动**——弱密钥等于任何人都能伪造令牌
# （DESIGN-AUTHN-001 DEC-05）。生成：openssl rand -base64 48
REGTO_AUTH_JWT_SECRET=<at-least-32-bytes-random>
REGTO_AUTH_JWT_ISSUER=regto
# 令牌有效期（可选，默认 15m / 168h）
# REGTO_AUTH_ACCESS_TTL=15m
# REGTO_AUTH_REFRESH_TTL=168h

# Redis
REGTO_REDIS_URL=redis://127.0.0.1:6379/0

# Web UI 的 refresh cookie（SPEC-WEB-001 REQ-04）。
# cookie 走 HttpOnly + SameSite=Lax + Path=/api/v1/auth；secure 由 REGTO_ENV 推导：
# local/dev/test/ci 视为 http 环境不加 Secure，其余一律加。
# 额外允许的浏览器来源（逗号分隔），只用于 CSRF 纵深防御；缺省只认同源。
# vite dev 跑在 5173、经 proxy 后 Origin 仍是 5173，所以要显式加进来：
# REGTO_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 服务
REGTO_HTTP_ADDR=127.0.0.1:8080
REGTO_LOG_LEVEL=info
REGTO_ENV=dev

# schema 版本无需配置：regto-server 启动时会比对「内嵌迁移的最新版本」
# 与「库内 schema_meta.version」，不一致直接拒绝启动（不做自动迁移）。
# 排障时看两边即可：regtoctl schema / go run ./cmd/migrate version

# AI 授权守卫（SPEC-AGENT-001）。默认 on。
# off 只用于本地排障：关闭后 AI 主体通过认证即可调用任何接口，启动时会打 WARN。
REGTO_AGENT_GUARD=on
# 留痕真源（jsonl）根目录，与 regtoctl 共用同一个目录；守卫的审批留痕写在这里
REGTO_TRACES_ROOT=traces
